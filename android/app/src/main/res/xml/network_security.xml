<?xml version="1.0" encoding="utf-8"?>
<!-- 很多音源和平台的歌曲链接是 http：允许明文；同步服务器的自签名证书在代码里按指纹校验 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>